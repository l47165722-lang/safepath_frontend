<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Guardian contact info (names/phone numbers) and the watch pairing
         code should not be swept up into a device backup. -->
    <exclude domain="sharedpref" path="safe_path_guardians.xml" />
    <exclude domain="sharedpref" path="safepath_wear_pairing.xml" />
</full-backup-content>
